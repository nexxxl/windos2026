{
  "name": "@nexlos/os",
  "version": "1.1.0-lite.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "NexlOS lite desktop for DeepSeek Harness: English-first, optional language and art packs.",
  "author": "NexlOS Authors",
  "keywords": [
    "ai-native",
    "agent-native",
    "agent-os",
    "web-os",
    "operating-system",
    "local-first",
    "byok",
    "deepseek-harness",
    "dsh",
    "plugin",
    "software-factory",
    "app-generator",
    "html-apps",
    "single-file"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexxxl/windos2026.git"
  },
  "homepage": "https://github.com/nexxxl/windos2026#readme",
  "bugs": "https://github.com/nexxxl/windos2026/issues",
  "type": "module",
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "always",
    "endOfLine": "lf",
    "proseWrap": "preserve"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./src/locale/*.json",
    "./icon": "./docs/assets/icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "!src/host",
    "docs/assets/icon.svg",
    "docs/legal",
    "README.md",
    "CHANGELOG.md",
    "docs/artcraftport/ATTRIBUTION.md",
    "LICENSE",
    "!src/extras/fonts-cjk"
  ],
  "dsh": {
    "bundle": {
      "patch": "./src/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "dependencies": {
    "jpeg-js": "^0.4.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "nexlos": {
    "edition": "lite",
    "packsBase": "/extras/",
    "packs": [
      "langs",
      "artcraftport"
    ]
  }
}
